HOME=/var/lib/pi-web-gateway
PI_WEB_AUTH_MODE=gateway
PI_WEB_PUBLIC_ORIGIN=https://pi.example.com
PI_WEB_APP_URL=http://127.0.0.1:30141
PI_WEB_GATEWAY_HOST=127.0.0.1
PI_WEB_GATEWAY_PORT=30142
PI_WEB_ALLOWED_HOSTS=pi.example.com
# Caddy on the same host is the only trusted source of forwarded headers.
PI_WEB_TRUSTED_PROXIES=127.0.0.1/32
PI_WEB_GATEWAY_STATE_DIR=/var/lib/pi-web-gateway
PI_WEB_GATEWAY_DB=/var/lib/pi-web-gateway/auth.db
PI_WEB_GATEWAY_SECRET_FILE=/var/lib/pi-web-gateway/secrets.json
PI_WEB_GATEWAY_ATTESTATION_SECRET=replace-with-the-output-of-pi-web-gateway-init
PI_WEB_RP_ID=pi.example.com
PI_WEB_RP_NAME=Pi Web
PI_WEB_AUTH_USERNAME=pi
PI_WEB_AUTH_DISPLAY_NAME=Pi Web Operator
